# =====================================================================
# IKARAMA — modèle de configuration (copier en .env et remplir les <SECRET>)
# ---------------------------------------------------------------------
# À placer à la RACINE du projet (à côté de backend/ et frontend/).
# Lu par Django ET par Vite. Les ${VARIABLE} sont remplacées automatiquement.
# Pas d'espace autour du « = ». Ne jamais commiter ce fichier.
# Remplacer chaque <SECRET> par la vraie valeur (ou laisser vide si inconnue).
# =====================================================================


# =====================================================================
# 1. HOTE & PORT
# =====================================================================
HOTE=10.5.120.23
DJANGO_PORT=4000
FRONTEND_PORT=4002

DJANGO_URL=http://${HOTE}:${DJANGO_PORT}
FRONTEND_URL=http://${HOTE}:${FRONTEND_PORT}


# =====================================================================
# 2. DJANGO
# =====================================================================

DEBUG=False
# Générer avec ça : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=<SECRET>
TIME_ZONE=Indian/Antananarivo

ALLOWED_HOSTS=localhost,127.0.0.1,${HOTE},10.0.0.1
CORS_ALLOWED_ORIGINS=${FRONTEND_URL},http://127.0.0.1:${FRONTEND_PORT}
CSRF_TRUSTED_ORIGINS=${FRONTEND_URL},http://127.0.0.1:${FRONTEND_PORT}

# Le site tourne en http:// : False
HTTPS=False


# =====================================================================
# 3. BASE DE DONNÉES — POSTGRESQL
# =====================================================================
DB_ENGINE=postgresql
DB_NAME=ikarama_v2
DB_USER=
DB_PASSWORD=<SECRET>
DB_HOST=127.0.0.1
DB_PORT=5432


# =====================================================================
# 4. CERTIFICATS (appels HTTPS vers 10.5.100.7 : Keycloak et API RH)
# =====================================================================
# systeme = utiliser les certificats reconnus par Windows (comme le navigateur).
# Sinon : chemin d'un fichier .pem de l'autorité interne, ex. D:/ikarama/certs/ca-interne.pem
# desactive = aucune vérification. Accepté même avec DEBUG=False
#             Paramètres > Contrôles de cohérence). systeme ou un .pem restent recommandés en production.
CA_BUNDLE=desactive


# =====================================================================
# 5. KEYCLOAK — CONNEXION DES UTILISATEURS (SSO)
# =====================================================================
# Même adresse que l'émetteur des jetons du portail :
# le navigateur ET Django utilisent celle-ci.
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
# Client PUBLIC utilisé par le navigateur (sans secret)
KEYCLOAK_CLIENT_ID=
DUREE_CACHE_JETON=60


# =====================================================================
# 6. API RH — SYNCHRONISATION DES EMPLOYÉS
# =====================================================================
EXTERNAL_API_EMPLOYE_URL=

EXTERNAL_API_KEYCLOAK_SERVER_URL=${KEYCLOAK_SERVER_URL}
EXTERNAL_API_KEYCLOAK_REALM=${KEYCLOAK_REALM}
EXTERNAL_API_KEYCLOAK_CLIENT_ID=
EXTERNAL_API_KEYCLOAK_CLIENT_SECRET=<SECRET>
# Mise à jour de sa propre fiche à l'ouverture de l'application :
# 0 = à chaque ouverture ; N = au plus une fois toutes les N heures
SYNC_CONNEXION_INTERVALLE_HEURES=0
# Durée (secondes) pendant laquelle la liste de l'API RH est réutilisée. 0 = toujours relire
DUREE_CACHE_API_RH=60


# =====================================================================
# 7. FRONTEND (VITE) — tout est déduit, rien à modifier
# Visible dans le navigateur : AUCUN SECRET ICI.
# =====================================================================
VITE_BACKEND_URL=${DJANGO_URL}
VITE_FRONTEND_PORT=${FRONTEND_PORT}
VITE_KEYCLOAK_BASE_URL=${KEYCLOAK_SERVER_URL}
VITE_KEYCLOAK_REALM=${KEYCLOAK_REALM}
VITE_KEYCLOAK_CLIENT_ID=${KEYCLOAK_CLIENT_ID}
# Photo de profil des employés : {matricule} est remplacé automatiquement
VITE_PHOTO_PROFIL_URL=


# =====================================================================
# 8. À VENIR — pas encore lu par le code (e-mails)
# =====================================================================
SITE_URL=${FRONTEND_URL}/

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.parera-madagascar.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<ADRESSE_EMAIL_ENVOI>
EMAIL_HOST_PASSWORD=<SECRET>
DEFAULT_FROM_EMAIL=<NOM> <ADRESSE_EMAIL_ENVOI>
# Adresse de l'application dans les e-mails (liens)
URL_APPLICATION=https://<ADRESSE_IKARAMA>

# ------------------------------------------------------------------
# Temps réel (WebSocket)
# ------------------------------------------------------------------
# Redis : file de messages et cache partagés entre les processus du serveur.
# Vide = mode mémoire, valable pour UN SEUL processus serveur (développement, petite installation).
REDIS_URL=
# Adresse du WebSocket vue par le navigateur, si elle diffère de VITE_BACKEND_URL (ex. wss://ikarama.exemple.mg)
VITE_WS_URL=
